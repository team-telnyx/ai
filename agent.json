    "underlying": {
      "package": "telnyx-cli (Go)",
      "binary": "telnyx",
      "version": "0.32.0",
      "syntax": "telnyx <resource[:subresource]> <command> [flags]",
      "note": "Vendored by @telnyx/agent-cli for endpoints without a telnyx-agent wrapper. Not the deprecated @telnyx/api-cli, which also installed a `telnyx` binary with different syntax.",
      "repo": "https://github.com/team-telnyx/telnyx-cli"
    }
  },
  "quickstart": {
    "signup": "curl -s https://telnyx.com/agent-signup.md",
    "signup_guide": "https://telnyx.com/agent-signup.md",
    "install": "npm install -g @telnyx/agent-cli",
    "auth": "export TELNYX_API_KEY=YOUR_KEY",
    "hello_world": [
      {
        "name": "Send an SMS",
        "commands": [
          "telnyx-agent setup-sms --country US --json",
          "telnyx-agent send-sms --from <phone_number from setup-sms> --to +15559876543 --text 'Hello from Telnyx!'"
        ]
      },
      {
        "name": "Chat with AI",
        "commands": [
          "telnyx-agent ai-chat --message '{\"role\":\"user\",\"content\":\"What can Telnyx do?\"}'"
        ]
      },
      {
        "name": "Search for numbers",
        "commands": [
          "telnyx-agent search-phone-numbers --country US --administrative-area CA --json"
        ]
      },
      {
        "name": "Create an AI assistant",
        "commands": [
          "telnyx-agent create-ai-assistant --name 'Support Bot' --instructions 'You are a helpful assistant.' --json"
        ]
      },
      {
        "name": "Store a file",
        "commands": [
          "AWS_ACCESS_KEY_ID=$TELNYX_API_KEY AWS_SECRET_ACCESS_KEY=$TELNYX_API_KEY aws s3 mb s3://my-bucket --endpoint-url https://us-central-1.telnyxcloudstorage.com",
          "AWS_ACCESS_KEY_ID=$TELNYX_API_KEY AWS_SECRET_ACCESS_KEY=$TELNYX_API_KEY aws s3 cp ./file.txt s3://my-bucket/file.txt --endpoint-url https://us-central-1.telnyxcloudstorage.com"
        ]
      }
    ]
  },
  "sdks": {
    "cli": {
      "name": "@telnyx/agent-cli",
