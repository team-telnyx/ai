{
  "$schema": "https://agent.telnyx.com/schemas/agent-manifest-v1.json",
  "name": "Telnyx",
  "description": "Programmable telecom platform — voice, messaging, email, IoT, AI, networking, storage.",
  "version": "1.0.0",
  "updated": "2026-09-03T00:00:00Z",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "prefix": "Bearer",
    "signup_guide": "https://telnyx.com/agent-signup.md",
    "signup_manifest": "https://telnyx.com/.well-known/agent-access.json",
    "docs": "https://developers.telnyx.com/docs/api/v2/overview#authentication"
  },
  "capabilities": [
    {
      "id": "messaging",
      "name": "SMS & MMS",
      "description": "Send and receive SMS/MMS worldwide. A2P, P2P, toll-free, short codes.",
      "guide": "/guides/sms-messaging.md",
      "cli": "telnyx-agent send-sms --from +15551234567 --to +15559876543 --text 'Hello'",
      "api": "POST /v2/messages",
      "docs": "https://developers.telnyx.com/docs/messaging",
      "requires": [
        "messaging_profile",
        "phone_number",
        "10dlc_registration"
      ]
    },
    {
      "id": "rcs",
      "name": "RCS Messaging",
      "description": "Send rich business messages and check recipient RCS capabilities before choosing content or fallback behavior.",
      "guide": "/guides/rcs-messaging.md",
      "cli": "telnyx-agent rcs-send --agent-id AGENT_ID --messaging-profile-id PROFILE_ID --to +15559876543 --text 'Hello from RCS'",
      "api": "POST /v2/messages/rcs",
      "docs": "https://developers.telnyx.com/docs/messaging/messages/rcs-capabilities",
      "requires": [
        "rcs_agent",
        "messaging_profile"
      ]
    },
    {
      "id": "voice",
      "name": "Voice & Call Control",
      "description": "Programmable voice calls with real-time call control, conferencing, IVR, recording.",
      "guide": "/guides/voice-call-control.md",
      "cli": "telnyx-agent call-dial --connection-id <id> --from +15551234567 --to +15559876543",
      "api": "POST /v2/calls",
      "docs": "https://developers.telnyx.com/docs/voice",
      "requires": [
        "voice_connection",
        "phone_number"
      ]
    },
    {
      "id": "ai_assistants",
      "name": "AI Voice Assistants",
      "description": "Deploy AI-powered voice assistants that answer calls with custom personalities and tools.",
      "guide": "/guides/ai-assistants.md",
      "cli": "telnyx-agent create-ai-assistant --name 'Support Bot' --instructions 'You are a helpful assistant.'",
      "api": "POST /v2/ai/assistants",
      "docs": "https://developers.telnyx.com/docs/ai/assistants",
      "requires": []
    },
    {
      "id": "ai_inference",
      "name": "AI Inference",
      "description": "LLM chat completions and embeddings via OpenAI-compatible API.",
      "cli": "telnyx-agent ai-chat --message '{\"role\":\"user\",\"content\":\"Hello\"}'",
      "api": "POST /v2/ai/chat/completions",
      "docs": "https://developers.telnyx.com/docs/ai/inference",
      "requires": []
    },
    {
      "id": "meeting_bot",
      "name": "Meeting Bot",
      "description": "Send a visible bot to Zoom, Google Meet, Microsoft Teams, or Webex to follow finalized transcripts, perform explicitly authorized live actions, and create transcript artifacts.",
      "guide": "/guides/meeting-bot.md",
      "api": "POST /v2/meeting_sessions",
      "docs": "https://developers.telnyx.com/docs/meeting",
      "requires": []
    },
    {
      "id": "email",
      "name": "Email",
      "description": "Send transactional email, manage inboxes and inbound messages, configure sending domains with DNS verification, and handle suppressions and unsubscribe groups.",
      "guide": "/guides/email.md",
      "api": "POST /v2/email_messages",
      "docs": "https://developers.telnyx.com/docs/email",
      "requires": [
        "sending_domain",
        "api_key"
      ]
    },
    {
      "id": "numbers",
      "name": "Phone Numbers",
      "description": "Search, buy, and manage phone numbers in 140+ countries.",
      "guide": "/guides/phone-numbers.md",
      "cli": "telnyx-agent search-phone-numbers --country US --json",
      "api": "GET /v2/available_phone_numbers",
      "docs": "https://developers.telnyx.com/docs/numbers",
      "requires": []
    },
    {
      "id": "verify",
      "name": "Phone Verification (2FA)",
      "description": "Send and verify codes via SMS, voice call, flash call, or WhatsApp.",
      "guide": "/guides/phone-verification.md",
      "cli": "telnyx-agent verify-send --phone-number +15551234567 --verify-profile-id prof_xxx --method whatsapp",
      "api": "POST /v2/verifications/whatsapp",
      "docs": "https://developers.telnyx.com/docs/verify",
      "requires": [
        "verify_profile"
      ]
    },
    {
      "id": "fax",
      "name": "Fax",
      "description": "Send and receive faxes programmatically.",
      "cli": "telnyx-agent fax-send --connection-id <id> --from <your-number> --to +15551234567 --media-url https://example.com/doc.pdf",
      "api": "POST /v2/faxes",
      "docs": "https://developers.telnyx.com/docs/fax",
      "requires": [
        "phone_number"
      ]
    },
    {
      "id": "iot",
      "name": "IoT & Wireless",
      "description": "Manage SIM cards, eSIMs, data plans, and global connectivity for IoT devices.",
      "cli": "telnyx-agent list-sim-cards --json",
      "api": "GET /v2/sim_cards",
      "docs": "https://developers.telnyx.com/docs/wireless",
      "requires": []
    },
    {
      "id": "storage",
      "name": "Cloud Storage",
      "description": "S3-compatible object storage for media, recordings, and files.",
      "cli": "AWS_ACCESS_KEY_ID=$TELNYX_API_KEY AWS_SECRET_ACCESS_KEY=$TELNYX_API_KEY aws s3 mb s3://my-bucket --endpoint-url https://us-central-1.telnyxcloudstorage.com",
      "api": "S3-compatible API at https://<region>.telnyxcloudstorage.com (AWS CLI/SDK; Telnyx API key as both access and secret key)",
      "docs": "https://developers.telnyx.com/docs/storage",
      "requires": []
    },
    {
      "id": "networking",
      "name": "Private Networking",
      "description": "Private IP mesh networking, cloud interconnects, multi-region infrastructure.",
      "guide": "/guides/wireguard-networking.md",
      "api": "POST /v2/networks",
      "docs": "https://developers.telnyx.com/docs/networking",
      "requires": []
    },
    {
      "id": "edge_compute",
      "name": "Edge Compute",
      "description": "Deploy webhook and MCP-adjacent functions on Telnyx edge infrastructure. Discovery and integration guidance live here; function lifecycle is handled by the separate telnyx-edge CLI, with a docs-first bridge focused on real testable handoff patterns.",
      "guide": "/guides/edge-compute.md",
      "cli": "telnyx-edge ship",
      "docs": "https://developers.telnyx.com/docs/edge-compute",
      "requires": []
    },
    {
      "id": "webhooks",
      "name": "Webhooks",
      "description": "Real-time event notifications for messaging, voice, and account events.",
      "guide": "/guides/webhooks.md",
      "api": "GET /v2/webhook_deliveries",
      "docs": "https://developers.telnyx.com/docs/webhooks",
      "requires": []
    },
    {
      "id": "10dlc",
      "name": "10DLC Registration",
      "description": "Register brands and campaigns for US A2P messaging compliance.",
      "guide": "/guides/10dlc-registration.md",
      "cli": "telnyx-agent setup-10dlc --phone +1XXXXXXXXXX --email you@example.com --brand-name 'My Business' --website https://example.com/sms-opt-in --sample-message 'My Business: Reply STOP to opt out.'",
      "api": "POST /v2/10dlc/brand",
      "docs": "https://developers.telnyx.com/docs/messaging/10dlc",
      "requires": []
    },
    {
      "id": "payments",
      "name": "x402 Crypto Payments",
      "description": "Fund account with USDC on Base blockchain via x402 protocol (authenticated; distinct from Telnyx's keyless pay-per-call x402 endpoints at x402.telnyx.com).",
      "guide": "/guides/x402-payments.md",
      "api": "POST /v2/x402/credit_account/quote",
      "docs": "https://telnyx.com/.well-known/agent-skills/telnyx-x402-payment/SKILL.md",
      "requires": []
    },
    {
      "id": "mpp_payments",
      "name": "MPP Payments",
      "description": "Fund account via Machine Payment Protocol (HTTP 402) with Stripe Link or Tempo USDC.",
      "guide": "/guides/mpp-payments.md",
      "api": "POST /v2/machine-payments/account-credit",
      "docs": "https://telnyx.com/.well-known/agent-skills/telnyx-mpp-payment/SKILL.md",
      "requires": []
    },
    {
      "id": "acp_payments",
      "name": "ACP Payments",
      "description": "Fund account through an Agentic Commerce Protocol (ACP) checkout with Stripe Link or Tempo USDC — create, complete, retrieve, and cancel checkouts with idempotency keys.",
      "guide": "/guides/acp-payments.md",
      "api": "POST /v2/checkout_sessions",
      "docs": "https://telnyx.com/.well-known/agent-skills/telnyx-acp-payment/SKILL.md",
      "requires": []
    },
    {
      "id": "porting",
      "name": "Number Porting",
      "description": "Check portability, create and manage port-in orders, upload LOA and supporting documents, track requirements and activation status, and monitor port-out activity.",
      "guide": "/guides/porting-orders.md",
      "cli": "telnyx-agent setup-porting --phone-numbers +13125550001,+13125550002 --customer-name 'Acme Corp'",
      "api": "POST /v2/porting_orders",
      "docs": "https://developers.telnyx.com/docs/porting",
      "requires": []
    }
  ],
