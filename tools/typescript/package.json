{
  "name": "@telnyx/agent-toolkit",
  "version": "0.3.0",
  "description": "Telnyx Agent Toolkit for TypeScript — tools for OpenAI, Vercel AI SDK, and LangChain.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai/toolkit.d.ts",
      "import": "./dist/openai/toolkit.js"
    },
    "./vercel-ai": {
      "types": "./dist/vercel-ai/toolkit.d.ts",
      "import": "./dist/vercel-ai/toolkit.js"
    },
    "./langchain": {
      "types": "./dist/langchain/toolkit.d.ts",
      "import": "./dist/langchain/toolkit.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/runtime-contract.test.mjs && tsx tests/integration.test.ts && tsx tests/rcs-call-control.test.ts && tsx tests/adapter-anyof.test.ts && tsx tests/path-encoding.test.ts && tsx tests/repointed-routes.test.ts && tsx tests/object-payloads.test.ts && tsx tests/compositions.test.ts && tsx tests/s3-storage.test.ts && tsx tests/s3-sdk.test.ts && node tests/optional-adapters.test.mjs",
    "test:parity": "tsx tests/definition-parity.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "telnyx",
    "agent",
    "toolkit",
    "openai",
    "langchain",
    "vercel-ai",
    "function-calling",
    "llm",
    "ai"
  ],
  "author": "Telnyx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/team-telnyx/ai.git",
    "directory": "tools/typescript"
  },
  "homepage": "https://github.com/team-telnyx/ai#readme",
  "bugs": {
    "url": "https://github.com/team-telnyx/ai/issues"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@langchain/core": ">=0.2.0",
    "ai": ">=3.0.0",
    "openai": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
